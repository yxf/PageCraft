{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "userScripts",
    "alarms"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*", "<all_urls>"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "index.html?surface=popup",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "side_panel": { "default_path": "index.html?surface=sidepanel" },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.openai.com https://api.deepseek.com https://generativelanguage.googleapis.com https://api.anthropic.com"
  }
}
