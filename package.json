{
  "name": "pagecraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "dev": "vite --host 127.0.0.1",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "format": "prettier --write src tests scripts public *.html *.json *.ts",
    "format:check": "prettier --check src tests scripts public *.html *.json *.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/chrome": "^0.0.300",
    "jsdom": "^26.0.0",
    "playwright": "^1.51.0",
    "esbuild": "^0.25.0",
    "@types/node": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "prettier": "^3.0.0"
  }
}
